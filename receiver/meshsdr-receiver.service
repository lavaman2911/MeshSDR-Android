[Unit]
Description=MeshSDR message receiver and Homarr dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshsdr
Group=meshsdr
WorkingDirectory=/opt/meshsdr-receiver
Environment=PYTHONUNBUFFERED=1
Environment=MESHSDR_CONFIG=/etc/meshsdr-receiver/config.yaml
ExecStart=/opt/meshsdr-receiver/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 9090
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/meshsdr-receiver /etc/meshsdr-receiver
PrivateTmp=true

[Install]
WantedBy=multi-user.target
